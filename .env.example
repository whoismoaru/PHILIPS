# ============================================================
#  PHILIPS — configuration. Copy this file to ".env" and fill it in.
#  NEVER share your .env or commit it. It holds the keys to your funds.
#  PHILIPS is single-owner by design: one running instance serves one person.
# ============================================================

# --- Telegram ---
# Token from @BotFather when you create a new bot.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram id (ask @userinfobot). ONLY this id may command the bot;
# every other user is rejected. This is the bot's entire access control — the
# wallet and all positions are global, so do not share the bot with anyone.
TELEGRAM_ALLOWED_USER_ID=

# --- Keystore encryption ---
# Passphrase used to encrypt data/keystore.json (scrypt + AES).
# STRONGLY RECOMMENDED: set a long random string here.
# If left empty, the bot token is used instead — and rotating your bot token then
# makes the stored key permanently unreadable.
# Changing this value invalidates an existing keystore: set it, restart, then
# reconnect the wallet through /settings.
WALLET_SECRET=

# --- Primary chain ---
# RPC endpoint and chain id of the chain you mainly LP on.
# Tested on Robinhood Chain. Another EVM chain needs edits in src/chains.ts —
# the explorer URL, the chain label, and the USDG address are set for Robinhood.
# Use your own keyed endpoint; public ones rate-limit and then every read fails at once.
RPC_URL=
CHAIN_ID=

# --- Uniswap v3 contracts on that chain ---
# Take these from the official Uniswap deployment list for your chain.
UNISWAP_V3_FACTORY=
UNISWAP_V3_POSITION_MANAGER=
UNISWAP_V3_QUOTER=
UNISWAP_V3_SWAP_ROUTER=
WETH_ADDRESS=

# --- BSC / PancakeSwap v3 (optional) ---
# true = enable BSC as a second chain. Contract addresses are built in.
BSC_ENABLED=false
# Empty = free public dataseed: fine for one person, rate-limited under load.
BSC_RPC_URL=

# --- Base (optional) ---
# true = enable Base as another chain. Contract addresses are built in.
# Bases: ETH/WETH and USDC. Empty RPC = https://mainnet.base.org (public).
BASE_ENABLED=false
BASE_RPC_URL=

# --- HyperEVM (optional) ---
# true = enable HyperEVM (Hyperliquid's EVM chain) as another chain.
# DEX is HyperSwap v3; contract addresses are built in.
# Bases: HYPE/WHYPE and USDT0. Empty RPC = https://rpc.hyperliquid.xyz/evm (public, rate-limited).
HYPEREVM_ENABLED=false
HYPEREVM_RPC_URL=

# --- Ink (optional) ---
# true = enable Ink (Kraken's L2) as another chain. LP venue is Velodrome Slipstream
# (concentrated liquidity); swaps/bridge route via Relay/LI.FI. Addresses built in.
# Bases: ETH/WETH and USDT0. Empty RPC = https://rpc-gel.inkonchain.com (public).
INK_ENABLED=false
INK_RPC_URL=

# --- Arc (optional, chain 5042) ---
# Circle's L1 where GAS IS USDC. Uniswap v3 AND v4 are deployed and their addresses are
# already built in (taken from @uniswap/sdk-core, each one verified on-chain). The only
# thing missing is a dependable RPC: the one public endpoint that answers,
# https://rpc.arc-scan.org, dropped about a third of the calls under test, so no default
# is shipped. The chain stays OUT of the registry until ARC_RPC_URL is filled in, even
# with ARC_ENABLED=true.
# There is no wrapped native and no ETH base here -- USDC is the only LP base.
ARC_ENABLED=false
ARC_RPC_URL=
# Optional private/paid BSC endpoint used for sending transactions (MEV-protected).
BSC_PRIVATE_RPC=

# --- Safety ---
# Max native amount per single transaction (e.g. 0.05). Empty = built-in default (0.1).
MAX_ETH_PER_TX=0.05        # 'off' or '0' removes the cap; empty falls back to 0.1
# A separate cap for stablecoin bases (USDT/USDG/USDC), in dollars. Empty falls back to 250.
MAX_TX_FEE_NATIVE=0.005    # per-tx GAS COST ceiling, in the native asset; 'off' removes it
MAX_STABLE_PER_TX=250      # 'off' or '0' removes the cap; empty falls back to 250
# true = simulate only, no transaction is ever sent. Start here.
DRY_RUN=true

# --- Token screening (optional) ---
# GMGN OpenAPI key, read-only. Empty = Tax/DEV/Insiders/Sniper/LP-Locked show "?".
# Requires the CLI: npm i -g gmgn-cli
GMGN_API_KEY=
# Only if "gmgn-cli" is not on the service PATH — give the absolute path here.
GMGN_CLI_BIN=

# --- Pool sources (optional) ---
# Krystal Cloud API key — a far more complete pool list than the Uniswap gateway
# alone. Empty = feature off, the bot falls back to the gateway + on-chain scan.
KRYSTAL_API_KEY=

# --- Legacy (optional) ---
# Old installs only: a plaintext private key here is adopted once into the
# encrypted keystore on first boot, after which this line can be deleted.
# Must be 64 hex characters (0x optional) — anything else is ignored with a
# message in the log, and the value is never printed.
# Prefer connecting through /settings instead of putting a key on disk.
PRIVATE_KEY=

# InsightX (holder clusters) -- optional; empty makes the Cluster row read "?"
INSIGHTX_API_KEY=
