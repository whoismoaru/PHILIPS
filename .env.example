# ============================================================
#  KONFIGURASI BOT — salin file ini jadi ".env" lalu isi.
#  JANGAN pernah bagikan file .env ke siapa pun. Ini kunci brankasmu.
# ============================================================

# --- Telegram ---
# Token dari @BotFather saat kamu bikin bot baru.
TELEGRAM_BOT_TOKEN=

# ID numerik Telegram-mu (dari @userinfobot). Hanya ID ini yang boleh perintah bot.
TELEGRAM_ALLOWED_USER_ID=

# --- Jaringan (Robinhood Chain) ---
# Alamat RPC & Chain ID Robinhood Chain. (Kita isi bareng nanti.)
RPC_URL=
CHAIN_ID=

# --- Dompet bot ---
# Private key dompet KHUSUS bot (dompet baru, isi sedikit). Diawali 0x.
PRIVATE_KEY=

# --- Alamat kontrak Uniswap v3 di Robinhood Chain ---
# (Kita isi bareng nanti dari dokumentasi resmi Uniswap.)
UNISWAP_V3_FACTORY=
UNISWAP_V3_POSITION_MANAGER=
UNISWAP_V3_QUOTER=
UNISWAP_V3_SWAP_ROUTER=
WETH_ADDRESS=

# --- Pengaman ---
# Batas ETH maksimum per satu transaksi (mis. 0.05). Bot menolak lebih dari ini.
MAX_ETH_PER_TX=0.05
# DRY_RUN=true artinya bot cuma SIMULASI, tidak benar-benar kirim transaksi.
DRY_RUN=true

# GMGN OpenAPI (read-only) — pengisi celah data screening.
# Kosong = field Tax/DEV/Insiders/Sniper/Bundler/LP Locked/Burnt tampil "?".
# Butuh gmgn-cli terpasang: npm i -g gmgn-cli
GMGN_API_KEY=
